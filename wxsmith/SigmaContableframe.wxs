<?xml version="1.0" encoding="utf-8" ?>
<wxsmith>
	<object class="wxFrame" name="SigmaContableFrame">
		<title>Sigma Contable v1.0</title>
		<icon stock_id="wxART_PLUS" stock_client="wxART_FRAME_ICON" />
		<size>800,600</size>
		<object class="wxSplitterWindow" name="ID_SPLITTERWINDOW1" variable="SplitterWindow1" member="yes">
			<sashpos>1</sashpos>
			<minsize>150</minsize>
			<orientation>vertical</orientation>
			<pos>216,280</pos>
			<size>10,0</size>
			<object class="wxPanel" name="ID_PANEL1" variable="Panel1" member="yes">
				<pos>234,175</pos>
				<object class="wxBoxSizer" variable="BoxSizer1" member="no">
					<orient>wxVERTICAL</orient>
					<object class="sizeritem">
						<object class="wxButton" name="ID_BUTTON1" variable="Button1" member="yes">
							<label>Libro Diario</label>
							<style>wxBORDER_NONE</style>
							<handler function="OnButton1Click" entry="EVT_BUTTON" />
						</object>
						<flag>wxALL|wxEXPAND</flag>
						<border>5</border>
						<option>1</option>
					</object>
					<object class="sizeritem">
						<object class="wxButton" name="ID_BUTTON2" variable="Button2" member="yes">
							<label>Libro Mayor</label>
							<style>wxBORDER_NONE</style>
							<handler function="OnButton2Click" entry="EVT_BUTTON" />
						</object>
						<flag>wxALL|wxEXPAND</flag>
						<border>5</border>
						<option>1</option>
					</object>
					<object class="sizeritem">
						<object class="wxButton" name="ID_BUTTON3" variable="Button3" member="yes">
							<label>Plan de Cuentas</label>
							<style>wxBORDER_NONE</style>
							<handler function="OnButton3Click" entry="EVT_BUTTON" />
						</object>
						<flag>wxALL|wxEXPAND</flag>
						<border>5</border>
						<option>1</option>
					</object>
					<object class="sizeritem">
						<object class="wxButton" name="ID_BUTTON4" variable="Button4" member="yes">
							<label>Balance</label>
							<style>wxBORDER_NONE</style>
						</object>
						<flag>wxALL|wxEXPAND</flag>
						<border>5</border>
						<option>1</option>
					</object>
					<object class="spacer">
						<flag>wxALL|wxEXPAND</flag>
						<border>5</border>
						<option>10</option>
					</object>
					<object class="sizeritem">
						<object class="wxHyperlinkCtrl" name="ID_HYPERLINKCTRL1" variable="HyperlinkCtrl1" member="yes">
							<label>CanuConde@2026</label>
							<url>https://canuconde.github.io</url>
						</object>
						<flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
						<border>5</border>
						<option>1</option>
					</object>
				</object>
			</object>
			<object class="wxPanel" name="ID_PANEL2" variable="Panel2" member="yes">
				<pos>152,176</pos>
				<object class="wxBoxSizer" variable="BoxSizer2" member="no">
					<object class="sizeritem">
						<object class="wxNotebook" name="ID_NOTEBOOK1" variable="Notebook1" member="yes">
							<style>wxNB_BOTTOM</style>
						</object>
						<flag>wxALL|wxEXPAND</flag>
						<border>5</border>
						<option>1</option>
					</object>
				</object>
			</object>
		</object>
		<object class="wxMenuBar" variable="MenuBar1" member="no">
			<object class="wxMenu" variable="Menu1" member="no">
				<label>&amp;Archivo</label>
				<object class="wxMenuItem" name="ID_MENUITEM1" variable="MenuItem3" member="yes">
					<label>Abrir</label>
				</object>
				<object class="wxMenuItem" name="ID_MENUITEM2" variable="MenuItem4" member="yes">
					<label>Guardar</label>
				</object>
				<object class="separator" />
				<object class="wxMenuItem" name="idMenuQuit" variable="MenuItem1" member="no">
					<label>Salir</label>
					<accel>Alt-F4</accel>
					<help>Salir de Sigma Contable</help>
					<handler function="OnQuit" entry="EVT_MENU" />
				</object>
			</object>
			<object class="wxMenu" variable="Menu3" member="yes">
				<label>Editar</label>
			</object>
			<object class="wxMenu" variable="Menu6" member="yes">
				<label>Contabilidad</label>
				<object class="wxMenuItem" name="ID_MENUITEM3" variable="MenuItem5" member="yes">
					<label>Libro Diario</label>
				</object>
				<object class="wxMenuItem" name="ID_MENUITEM4" variable="MenuItem6" member="yes">
					<label>Libro Mayor</label>
				</object>
				<object class="wxMenuItem" name="ID_MENUITEM5" variable="MenuItem7" member="yes">
					<label>Plan de Cuentas</label>
				</object>
				<object class="wxMenuItem" name="ID_MENUITEM6" variable="MenuItem8" member="yes">
					<label>Asientos</label>
				</object>
				<object class="wxMenuItem" name="ID_MENUITEM7" variable="MenuItem9" member="yes">
					<label>Ejercicios</label>
				</object>
			</object>
			<object class="wxMenu" variable="Menu5" member="yes">
				<label>Reportes</label>
			</object>
			<object class="wxMenu" variable="Menu4" member="yes">
				<label>Herramientas</label>
			</object>
			<object class="wxMenu" variable="Menu2" member="no">
				<label>Ayuda</label>
				<object class="wxMenuItem" name="idMenuAbout" variable="MenuItem2" member="no">
					<label>Acerca de..</label>
					<accel>F1</accel>
					<help>Información de la versión</help>
					<handler function="OnAbout" entry="EVT_MENU" />
				</object>
			</object>
		</object>
		<object class="wxStatusBar" name="ID_STATUSBAR1" variable="StatusBar1" member="yes">
			<fields>1</fields>
			<widths>-1</widths>
			<styles>wxSB_NORMAL</styles>
		</object>
		<object class="wxMessageDialog" name="ID_MESSAGEDIALOG1" variable="MessageDialog1" member="yes">
			<caption>Message</caption>
			<message>Sigma Contable Desarrollado por  Sebastian Bergara Conde</message>
			<style>wxOK</style>
		</object>
		<object class="wxToolBar" name="ID_TOOLBAR1" variable="ToolBar1" member="yes">
			<object class="tool" name="ID_TOOLBARITEM1" variable="ToolBarItem1" member="yes">
				<label>Nuevo Asiento</label>
				<bitmap stock_id="wxART_NEW" stock_client="wxART_TOOLBAR" />
			</object>
			<object class="tool" name="ID_TOOLBARITEM2" variable="ToolBarItem2" member="yes">
				<label>Buscar</label>
				<bitmap stock_id="wxART_FIND" />
			</object>
			<object class="tool" name="ID_TOOLBARITEM3" variable="ToolBarItem3" member="yes">
				<label>Reportes</label>
				<bitmap stock_id="wxART_EXECUTABLE_FILE" />
			</object>
		</object>
		<object class="wxHtmlEasyPrinting" variable="HtmlEasyPrinting1" member="yes" />
		<object class="wxImage" variable="Image1" member="yes" />
	</object>
</wxsmith>
