<?xml version="1.0" encoding="utf-8" ?>
<wxsmith>
	<object class="wxFrame" name="NuevaCuentaFrame">
		<title>Nueva Cuenta</title>
		<size>600,128</size>
		<pos_arg>1</pos_arg>
		<size_arg>1</size_arg>
		<style>wxDEFAULT_FRAME_STYLE|wxFRAME_NO_TASKBAR|wxFRAME_FLOAT_ON_PARENT</style>
		<object class="wxPanel" name="ID_PANEL1" variable="Panel1" member="yes">
			<pos>192,248</pos>
			<object class="wxBoxSizer" variable="BoxSizer2" member="no">
				<orient>wxVERTICAL</orient>
				<object class="sizeritem">
					<object class="wxBoxSizer" variable="BoxSizer3" member="no">
						<object class="sizeritem">
							<object class="wxBoxSizer" variable="BoxSizer1" member="no">
								<orient>wxVERTICAL</orient>
								<object class="sizeritem">
									<object class="wxStaticText" name="ID_STATICTEXT1" variable="StaticText1" member="yes">
										<label>Código:</label>
									</object>
									<flag>wxALL|wxALIGN_LEFT</flag>
									<border>5</border>
								</object>
								<object class="sizeritem">
									<object class="wxTextCtrl" name="ID_TEXTCTRL1" variable="TextCtrlCodigo" member="yes" />
									<flag>wxALL|wxEXPAND</flag>
									<border>5</border>
								</object>
							</object>
							<flag>wxALL|wxALIGN_TOP</flag>
							<border>5</border>
						</object>
						<object class="sizeritem">
							<object class="wxBoxSizer" variable="BoxSizer5" member="no">
								<orient>wxVERTICAL</orient>
								<object class="sizeritem">
									<object class="wxStaticText" name="ID_STATICTEXT2" variable="StaticText2" member="yes">
										<label>Nombre:</label>
									</object>
									<flag>wxALL|wxALIGN_LEFT</flag>
									<border>5</border>
								</object>
								<object class="sizeritem">
									<object class="wxTextCtrl" name="ID_TEXTCTRL2" variable="TextCtrlNombre" member="yes" />
									<flag>wxALL|wxEXPAND</flag>
									<border>5</border>
								</object>
							</object>
							<flag>wxALL|wxALIGN_TOP</flag>
							<border>5</border>
							<option>1</option>
						</object>
						<object class="sizeritem">
							<object class="wxBoxSizer" variable="BoxSizer6" member="no">
								<orient>wxVERTICAL</orient>
								<object class="sizeritem">
									<object class="wxStaticText" name="ID_STATICTEXT3" variable="StaticText3" member="yes">
										<label>Tipo:</label>
									</object>
									<flag>wxALL|wxALIGN_LEFT</flag>
									<border>5</border>
								</object>
								<object class="sizeritem">
									<object class="wxChoice" name="ID_CHOICE1" variable="ChoiceRubro" member="yes">
										<content>
											<item>ACTIVO</item>
											<item>PASIVO</item>
											<item>PATRIMONIO</item>
											<item>INGRESOS</item>
											<item>EGRESOS</item>
										</content>
										<style>wxWANTS_CHARS</style>
									</object>
									<flag>wxALL|wxEXPAND</flag>
									<border>5</border>
									<option>1</option>
								</object>
							</object>
							<flag>wxALL|wxALIGN_TOP</flag>
							<border>5</border>
							<option>1</option>
						</object>
					</object>
					<flag>wxEXPAND</flag>
					<border>5</border>
				</object>
				<object class="sizeritem">
					<object class="wxBoxSizer" variable="BoxSizer4" member="no">
						<object class="spacer">
							<flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
							<border>5</border>
							<option>1</option>
						</object>
						<object class="sizeritem">
							<object class="wxButton" name="ID_BUTTON1" variable="Button1" member="yes">
								<label>Guardar</label>
								<handler function="OnButton1Click" entry="EVT_BUTTON" />
							</object>
							<flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
							<border>5</border>
						</object>
						<object class="sizeritem">
							<object class="wxButton" name="ID_BUTTON2" variable="Button2" member="yes">
								<label>Cancelar</label>
								<handler function="OnButton2Click" entry="EVT_BUTTON" />
							</object>
							<flag>wxALL|wxALIGN_CENTER_VERTICAL</flag>
							<border>5</border>
						</object>
					</object>
					<flag>wxEXPAND</flag>
					<border>5</border>
				</object>
			</object>
		</object>
	</object>
</wxsmith>
